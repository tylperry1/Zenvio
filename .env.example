DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_SETUP_TOKEN=
# Optional email verification and password recovery; use a verified sender.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
AUTH_EMAIL_FROM=

# Stable server-only secret for encrypted admin-managed provider credentials.
INTEGRATION_ENCRYPTION_KEY=
# Leave disabled until entitlements and paid features pass billing acceptance tests.
# Keep false during prelaunch. Set true explicitly to open public signup and paid checkout after acceptance checks.
BILLING_CHECKOUT_ENABLED=false

# Optional direct Google Calendar OAuth. Credentials may also be set in master admin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Microsoft Graph OAuth. Credentials may also be stored in the encrypted Integration Vault.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Authenticates scheduled calendar retries (production only).
CRON_SECRET=

# Twilio SMS remains disabled until credentials, sender/A2P registration, and
# contact-consent acceptance tests are complete. Credentials can instead be
# stored in the encrypted Integration Vault.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_MESSAGING_ENABLED=false
